<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:localFormFields="clr-namespace:Mimeo.DynamicUI.Avalonia.FormFields;assembly=Mimeo.DynamicUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.IntegerField"
			 x:DataType="localFormFields:FormFieldViewModel">
	<UserControl.Resources>
		<localFormFields:IntegerToDecimalConverter x:Key="IntegerToDecimalConverter" />
	</UserControl.Resources>
	<NumericUpDown Value="{Binding Value, Converter={StaticResource IntegerToDecimalConverter}}" FormatString="0">
		<NumericUpDown.IsEnabled>
			<MultiBinding Converter="{x:Static BoolConverters.Or}">
				<Binding Path="!FormFieldDefinition.ReadOnly" />
				<Binding Path="!FormFieldDefinition.Disabled" />
			</MultiBinding>
		</NumericUpDown.IsEnabled>
	</NumericUpDown>
</UserControl>
