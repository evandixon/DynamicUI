<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:localFormFields="clr-namespace:Mimeo.DynamicUI.Avalonia.FormFields;assembly=Mimeo.DynamicUI.Avalonia"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.ComboboxField"
			 x:DataType="localFormFields:FormFieldViewModel">
	<AutoCompleteBox SelectedItem="{Binding Value}" ItemsSource="{Binding FormFieldDefinition.Items}">
		<AutoCompleteBox.IsEnabled>
			<MultiBinding Converter="{x:Static BoolConverters.Or}">
				<Binding Path="!FormFieldDefinition.ReadOnly" />
				<Binding Path="!FormFieldDefinition.Disabled" />
			</MultiBinding>
		</AutoCompleteBox.IsEnabled>
		<i:Interaction.Behaviors>
			<localFormFields:AutoCompleteZeroMinimumPrefixLengthDropdownBehavior/>
		</i:Interaction.Behaviors>
	</AutoCompleteBox>
</UserControl>
