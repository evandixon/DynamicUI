<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"	
			 xmlns:dynamicUI="clr-namespace:Mimeo.DynamicUI;assembly=Mimeo.DynamicUI"
			 xmlns:local="clr-namespace:Mimeo.DynamicUI.Avalonia;assembly=Mimeo.DynamicUI.Avalonia"
			 xmlns:localFormFields="clr-namespace:Mimeo.DynamicUI.Avalonia.FormFields;assembly=Mimeo.DynamicUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.TextField"
			 x:DataType="localFormFields:FormFieldViewModel">
	<Grid>
		<TextBox IsVisible="{Binding !FormFieldDefinition.MultiLine}" Text="{Binding Value}" AcceptsReturn="false" IsReadOnly="{Binding FormFieldDefinition.ReadOnly}" IsEnabled="{Binding !FormFieldDefinition.Disabled}" />
		<TextBox IsVisible="{Binding FormFieldDefinition.MultiLine}" Text="{Binding Value}" AcceptsReturn="true" Height="100" IsReadOnly="{Binding FormFieldDefinition.ReadOnly}" IsEnabled="{Binding !FormFieldDefinition.Disabled}" />
	</Grid>
</UserControl>
