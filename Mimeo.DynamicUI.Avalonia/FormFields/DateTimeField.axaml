<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:localControls="clr-namespace:Mimeo.DynamicUI.Avalonia.Controls;assembly=Mimeo.DynamicUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.DateTimeField">

	<localControls:TranslatedDateTimePicker Value="{Binding Value}" DataContext="{Binding}">
		<localControls:DateTimePicker.IsEnabled>
			<MultiBinding Converter="{x:Static BoolConverters.Or}">
				<Binding Path="!FormFieldDefinition.ReadOnly" />
				<Binding Path="!FormFieldDefinition.Disabled" />
			</MultiBinding>
		</localControls:DateTimePicker.IsEnabled>
	</localControls:TranslatedDateTimePicker>
</UserControl>
