<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localFormFields="clr-namespace:Mimeo.DynamicUI.Avalonia.FormFields;assembly=Mimeo.DynamicUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.FormFields.ColorField"
             x:DataType="localFormFields:FormFieldViewModel">
    <UserControl.Resources>
        <localFormFields:ColorConverter x:Key="ColorConverter" />
    </UserControl.Resources>
    <ColorPicker HorizontalAlignment="Left" Color="{Binding Value, Converter={StaticResource ColorConverter}}" />
</UserControl>
