<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dynamicForms="clr-namespace:Mimeo.DynamicUI.Avalonia.Forms"
             xmlns:dynamicFormFields="clr-namespace:Mimeo.DynamicUI.Avalonia.FormFields"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.FormFields.TableField"
             x:DataType="dynamicFormFields:FormFieldViewModel">
    <dynamicForms:InlineEditGrid Name="TheInlineEditGrid" DataContext="{Binding Value}" NewItemCreator="{Binding FormFieldDefinition.NewItemCreator}" />
</UserControl>
