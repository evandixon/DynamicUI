<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mimeo.DynamicUI.Avalonia.Controls.DateTimePicker"
			 x:Name="DateTimePickerElement">
	<StackPanel Orientation="Horizontal" IsEnabled="{Binding #DateTimePickerElement.IsEnabled}">		
		<DatePicker SelectedDate="{Binding #DateTimePickerElement.SelectedDate}" />
		<TimePicker SelectedTime="{Binding #DateTimePickerElement.SelectedTime}" />
	</StackPanel>
</UserControl>
